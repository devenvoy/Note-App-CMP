CREATE TABLE IF NOT EXISTS noteEntity(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    note_id TEXT UNIQUE ,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    colorRes INTEGER,
    categoryId TEXT,
    isSynced INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    pendingDeletion INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT,
    updatedAt TEXT,
    FOREIGN KEY (categoryId) REFERENCES categoryEntity(categoryId)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- Existing queries
getAllNotes:
SELECT * FROM noteEntity
WHERE isDeleted = 0;

getAllUnsyncedNotes:
SELECT * FROM noteEntity
WHERE isSynced = 0 AND isDeleted = 0;

getAllSyncedNotes:
SELECT * FROM noteEntity
WHERE isSynced = 1 AND isDeleted = 0;

getNoteById:
SELECT * FROM noteEntity
WHERE id = ? AND isDeleted = 0;

getNoteByNoteId:
SELECT * FROM noteEntity
WHERE note_id= ? AND isDeleted = 0;

insertNote:
INSERT OR REPLACE INTO noteEntity (id,note_id,title,content,colorRes,categoryId,isSynced,isDeleted,pendingDeletion,createdAt,updatedAt)
VALUES (?,?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markNoteAsSynced:
UPDATE noteEntity SET isSynced = 1 WHERE id = ?;

deleteNoteById:
DELETE FROM noteEntity WHERE id = ?;

deleteNoteByNoteId:
DELETE FROM noteEntity WHERE note_id = ?;

emptyNoteTable:
DELETE FROM noteEntity;

markAsDeletedById:
UPDATE noteEntity
SET isDeleted = 1, pendingDeletion = 0, isSynced = 0
WHERE id = ?;

markForDeletionById:
UPDATE noteEntity
SET pendingDeletion = 1, isSynced = 0
WHERE id = ?;

-- Mark operations by note_id (rename your existing ones for clarity)
markAsDeletedByNoteId:
UPDATE noteEntity
SET isDeleted = 1, pendingDeletion = 0, isSynced = 0
WHERE note_id = ?;

markForDeletionByNoteId:
UPDATE noteEntity
SET pendingDeletion = 1, isSynced = 0
WHERE note_id = ?;

-- Cleanup query for permanently removing synced deleted notes
cleanupDeletedNotes:
DELETE FROM noteEntity
WHERE isDeleted = 1 AND pendingDeletion = 0;

markAsDeleted:
UPDATE noteEntity
SET isDeleted = 1, pendingDeletion = 0, isSynced = 0
WHERE note_id = ?;

markForDeletion:
UPDATE noteEntity
SET pendingDeletion = 1, isSynced = 0
WHERE note_id = ?;

getNotesMarkedForDeletion:
SELECT * FROM noteEntity
WHERE pendingDeletion = 1;

getDeletedNote:
SELECT * FROM noteEntity
WHERE note_id = ? AND isDeleted = 1;

softDeleteNote:
UPDATE noteEntity
SET isDeleted = 1, pendingDeletion = 1, isSynced = 0
WHERE note_id = ?;

restoreNote:
UPDATE noteEntity
SET isDeleted = 0, pendingDeletion = 0, isSynced = 0
WHERE id = ?;

getAllDeletedNotes:
SELECT * FROM noteEntity WHERE isDeleted = 1;

lastInsertRowId:
SELECT last_insert_rowid();