CREATE TABLE IF NOT EXISTS noteEntity(
    id TEXT PRIMARY KEY,
    ownerId TEXT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    colorRes INTEGER NOT NULL,
    categoryId TEXT,
    categoryName TEXT NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 0
);

getAllNotes:
SELECT * FROM noteEntity;

getAllUnsyncedNotes:
SELECT * FROM noteEntity
WHERE isSynced = 0;

getAllSyncedNotes:
SELECT * FROM noteEntity
WHERE isSynced = 1;

getNoteById:
SELECT * FROM noteEntity
WHERE id = ?;

insertNote:
INSERT OR REPLACE INTO noteEntity (id,ownerId,title,content,colorRes,categoryId,categoryName,isSynced)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

markNoteAsSynced:
UPDATE noteEntity SET isSynced = 1 WHERE id = ?;

deleteNoteById:
DELETE FROM noteEntity WHERE id = ?;

emptyNoteTable:
DELETE FROM noteEntity;