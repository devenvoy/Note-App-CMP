CREATE TABLE IF NOT EXISTS noteEntity(
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    colorRes INTEGER NOT NULL,
    categoryId TEXT,
    isSynced INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT,
    updatedAt TEXT,
    FOREIGN KEY (categoryId) REFERENCES categoryEntity(categoryId)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

getAllNotes:
SELECT * FROM noteEntity;

getAllUnsyncedNotes:
SELECT * FROM noteEntity
WHERE isSynced = 0;

getAllSyncedNotes:
SELECT * FROM noteEntity
WHERE isSynced = 1;

getNoteById:
SELECT * FROM noteEntity
WHERE id = ?;

insertNote:
INSERT OR REPLACE INTO noteEntity (id,title,content,colorRes,categoryId,isSynced,createdAt,updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

markNoteAsSynced:
UPDATE noteEntity SET isSynced = 1 WHERE id = ?;

deleteNoteById:
DELETE FROM noteEntity WHERE id = ?;

emptyNoteTable:
DELETE FROM noteEntity;